<UserControl x:Class="ArcGisProBridgeAddIn.Pane.ClaudePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource PaneSurface}"
             Foreground="{DynamicResource PaneForeground}"
             FontFamily="Segoe UI"
             FontSize="12">

  <UserControl.Resources>
    <!--
      A flat, quiet button. The default WPF chrome reads as a dialog control and
      would fight the terminal it sits above.
    -->
    <Style x:Key="PaneButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PaneForegroundMuted}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PaneSurfaceMuted}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PaneBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource PaneForeground}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--
      One slim strip of native chrome is what makes the pane read as part of
      ArcGIS Pro rather than a console someone docked: it names the session,
      shows whether the bridge is live, and offers the only control a terminal
      really needs.
    -->
    <Border Grid.Row="0"
            Background="{DynamicResource PaneSurface}"
            BorderBrush="{DynamicResource PaneBorder}"
            BorderThickness="0,0,0,1"
            Padding="10,0">
      <Grid Height="30">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Ellipse x:Name="StatusDot"
                 Grid.Column="0"
                 Width="8"
                 Height="8"
                 Margin="0,0,8,0"
                 VerticalAlignment="Center" />

        <TextBlock x:Name="TitleText"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Claude" />

        <TextBlock x:Name="ProjectText"
                   Grid.Column="2"
                   Margin="10,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource PaneForegroundMuted}"
                   TextTrimming="CharacterEllipsis" />

        <Button x:Name="RestartButton"
                Grid.Column="3"
                Content="Restart"
                Style="{StaticResource PaneButton}"
                ToolTip="End the current session and start a new one" />
      </Grid>
    </Border>

    <wv2:WebView2 x:Name="Browser" Grid.Row="1" />

    <!-- Shown only when the web view itself cannot be created. -->
    <TextBlock x:Name="FallbackText"
               Grid.Row="1"
               Margin="24"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="{DynamicResource PaneForegroundMuted}"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Visibility="Collapsed" />
  </Grid>
</UserControl>
